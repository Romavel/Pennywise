rules_version = '2';

// Every user's data lives under users/{uid} and only that user can access it.
// Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/transactions/{transactionId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && isValidTransaction(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid)
        && isValidTransaction(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(uid);
    }

    // One budget per category and month: the id is "{monthKey}_{categoryId}".
    match /users/{uid}/budgets/{budgetId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && isValidBudget(request.resource.data)
        && budgetId == request.resource.data.monthKey + '_' + request.resource.data.categoryId
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Only the limit can change.
      allow update: if isOwner(uid)
        && isValidBudget(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['limitMinor', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(uid);
    }

    function isValidBudget(data) {
      let fields = ['categoryId', 'monthKey', 'limitMinor', 'currency',
                    'createdAt', 'updatedAt'];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.categoryId is string
        && data.categoryId.matches('^[a-z0-9_]{1,64}$')
        && data.monthKey is string
        && data.monthKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && data.limitMinor is int
        && data.limitMinor > 0
        && data.limitMinor <= 100000000000
        && data.currency is string
        && data.currency.matches('^[A-Z]{3}$');
    }

    // Mirrors the client-side validation in the Flutter app.
    function isValidTransaction(data) {
      let fields = ['type', 'amountMinor', 'currency', 'categoryId', 'note',
                    'occurredAt', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.type in ['income', 'expense']
        && data.amountMinor is int
        && data.amountMinor > 0
        && data.amountMinor <= 100000000000
        && data.currency is string
        && data.currency.matches('^[A-Z]{3}$')
        && data.categoryId is string
        && data.categoryId.size() > 0
        && data.categoryId.size() <= 64
        && data.note is string
        && data.note.size() <= 200
        && data.occurredAt is timestamp;
    }
  }
}
